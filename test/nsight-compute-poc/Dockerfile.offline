ARG CUDA_IMAGE=nvidia/cuda:12.4.1-base-ubuntu22.04

FROM ${CUDA_IMAGE}

ARG NSIGHT_COMPUTE_DEB=nsight-compute-2024.1.1_2024.1.1.4-1_amd64.deb

COPY ${NSIGHT_COMPUTE_DEB} /tmp/nsight-compute.deb

RUN dpkg -i /tmp/nsight-compute.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/nsight-compute.deb \
    && ncu_path="$(find /opt/nvidia -path '*nsight-compute*/ncu' -type f | grep -v '/target/' | head -n 1)" \
    && printf '#!/bin/sh\nexec "%s" "$@"\n' "${ncu_path}" > /usr/local/bin/ncu \
    && chmod +x /usr/local/bin/ncu \
    && command -v ncu \
    && ncu --version
